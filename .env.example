# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-64-character-hex-string-using-command-above

# Database
# Development (SQLite)
DATABASE_URL=sqlite:///zenpdf_dev.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost:5432/zenpdf

# Server
HOST=0.0.0.0
PORT=5000

# Email Configuration (SendGrid, Mailgun, or SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@zenpdf.com

# PayPal Payment Integration (PRIMARY)
# Get sandbox credentials from: https://developer.paypal.com/dashboard
# Sandbox URL: https://api-m.sandbox.paypal.com
# Production URL: https://api-m.paypal.com
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Legacy Payment Integrations
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_PREMIUM=price_your_premium_price_id

PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_IPN_URL=https://bestpdfconverter.online/payment/ipn
PESAPAL_CALLBACK_URL=https://bestpdfconverter.online/payment/callback

# Redis (for rate limiting)
# Development: use in-memory
REDIS_URL=memory://

# Production: use actual Redis
# REDIS_URL=redis://localhost:6379/0

# Google AdSense
ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXX

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# AI Document Intelligence
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Alternative: OpenAI (fallback if Anthropic not configured)
# Get your API key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Which AI provider to use by default: 'anthropic' or 'openai'
AI_PROVIDER=anthropic

